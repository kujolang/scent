{
  "name": "scent-launch-readiness",
  "version": "0.1.0",
  "tests": [
    {
      "name": "Scent version command succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "kujo run scent.kujo version"
      }
    },
    {
      "name": "Scent static check succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "kujo check scent.kujo"
      }
    },
    {
      "name": "Scent dry-run JSON smoke succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "python3 tests/hardening.py Hardening.test_isolated_eval_smoke"
      }
    },
    {
      "name": "Scent version metadata exists",
      "check": "file_exists",
      "params": {
        "path": "VERSION"
      }
    }
  ]
}
